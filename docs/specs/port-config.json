{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PortConfig",
  "description": "Profile extension defining pluggable port configurations and adapter bindings for the Daily Tasks MCP server.",
  "type": "object",
  "workspace_root": "D:/vaults/work",
  "messages_root": "D:/vaults/work/inbox",
  "credentials_root": ".nyssa-ai/daily-tasks/credentials",
  "ports": {
    "project_plan": [
      {
        "name": "markdown-projects",
        "adapter": "MarkdownProjectSource",
        "enabled": true,
        "path": "projects/**/*.md",
        "settings": {
          "exclude_patterns": ["**/inputs/**", "**/outputs/**", "**/.trash/**"],
          "cache_ttl_seconds": 14400
        }
      }
    ],
    "daily_plan": [
      {
        "name": "markdown-daily-plans",
        "adapter": "MarkdownDailyPlanSource",
        "enabled": true,
        "path": "daily-plans/YYYY.MM.DD-daily-plan.md",
        "settings": {
          "active_template": "dailyPlan"
        }
      }
    ],
    "communication": [
      {
        "name": "gmail",
        "adapter": "GmailSource",
        "enabled": true,
        "package": "daily-tasks[gmail]",
        "read_only": true,
        "scopes": ["https://www.googleapis.com/auth/gmail.readonly"],
        "credentials_file": ".nyssa-ai/daily-tasks/credentials/gmail-oauth.json",
        "fetch_limit": 50,
        "poll_interval_seconds": 300,
        "download_attachments": true,
        "max_attachment_bytes": 10485760
      },
      {
        "name": "slack",
        "adapter": "SlackSource",
        "enabled": true,
        "package": "daily-tasks[slack]",
        "read_only": true,
        "scopes": ["channels:history", "channels:read", "groups:history", "im:history", "mpim:history"],
        "token_env_var": "SLACK_USER_TOKEN",
        "channels": ["#dev-core", "#daily-sync"],
        "fetch_limit": 50,
        "poll_interval_seconds": 300
      }
    ],
    "file_store": {
      "name": "markdown-file-store",
      "adapter": "MarkdownFileStore",
      "records_root": "projects",
      "daily_plans_root": "daily-plans",
      "state_root": ".nyssa-ai/daily-tasks",
      "settings": {
        "enforce_optimistic_locking": true,
        "atomic_writes": true,
        "preserve_comments_and_whitespace": true
      }
    }
  }
}
