# Single root scratch directory (REPO-SCRATCH; includes .temp/dist/ staged bundles)
.temp/

# Mutable runtime state & self-loaded harness plugin trees (never inside repo_root)
.nyssa-ai/*/runtime/
.agents/
.hermes/

# Tracked documentation and CodeGraph AST snapshot
!docs/
!docs/code-map/
!docs/code-map/codegraph.db

# Host plugin manifests
!/.claude-plugin/
!/.codex-plugin/
!/.cursor-plugin/

node_modules/
.DS_Store
*.tmp

