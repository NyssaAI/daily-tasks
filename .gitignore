__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.venv/
venv/
ENV/
env/

# Visual Studio and VS Code
.vs/
*.sln.docstates
*.suo
*.user
*.userosscache
*.sln.ide
*.vcxproj.user

.worktrees/
