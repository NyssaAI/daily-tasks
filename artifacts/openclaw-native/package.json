{
  "name": "@nyssaai/daily-tasks-openclaw",
  "version": "0.6.1",
  "description": "Native OpenClaw adapter for optional Daily Tasks project-index prewarming",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./adapters/openclaw/index.mjs"
    ],
    "install": {
      "minHostVersion": ">=2026.10.2"
    },
    "compat": {
      "pluginApi": ">=2026.10.2"
    }
  }
}
