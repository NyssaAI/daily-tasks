{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "daily-tasks": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${PLUGIN_ROOT}/src/daily_tasks/launch_mcp.py"
      ],
      "cwd": "${PLUGIN_DATA}",
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${PLUGIN_DATA}/.venv"
      }
    }
  }
}
